{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "J-60-asset-manifest.schema.json",
  "title": "J-60 Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "schemaVersion",
    "run",
    "document",
    "status",
    "coverage",
    "issues",
    "assets",
    "summary"
  ],
  "properties": {
    "contractId": {
      "const": "J-60"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "run": {
      "$ref": "J-00-common-definitions.schema.json#/$defs/runInfo"
    },
    "document": {
      "$ref": "J-00-common-definitions.schema.json#/$defs/documentRef"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "J-00-common-definitions.schema.json#/$defs/coverageItem"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "J-00-common-definitions.schema.json#/$defs/issue"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "J-00-common-definitions.schema.json#/$defs/assetRef"
      }
    },
    "summary": {
      "$ref": "J-00-common-definitions.schema.json#/$defs/summary"
    }
  }
}
