{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "J-90-evaluation-report.schema.json",
  "title": "J-90 Evaluation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "schemaVersion",
    "evaluatorId",
    "runId",
    "generatedAt",
    "target",
    "result",
    "checks",
    "findings",
    "metrics",
    "humanReviewStatus"
  ],
  "properties": {
    "contractId": {
      "const": "J-90"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "evaluatorId": {
      "enum": [
        "EV-01",
        "EV-02"
      ]
    },
    "runId": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "result": {
      "enum": [
        "PASS",
        "PASS_WITH_WARNINGS",
        "FAIL"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkId",
          "name",
          "result",
          "details"
        ],
        "properties": {
          "checkId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "result": {
            "enum": [
              "PASS",
              "WARNING",
              "FAIL",
              "NOT_APPLICABLE"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingId",
          "severity",
          "category",
          "summary",
          "evidence",
          "affectedIds",
          "recommendedAction"
        ],
        "properties": {
          "findingId": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "blocking",
              "warning",
              "info"
            ]
          },
          "category": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affectedIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendedAction": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkedRecordCount",
        "missingRecordCount",
        "unsupportedFactCount",
        "untraceableRecordCount",
        "unaccountedSourceUnitCount"
      ],
      "properties": {
        "checkedRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "missingRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "unsupportedFactCount": {
          "type": "integer",
          "minimum": 0
        },
        "untraceableRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "unaccountedSourceUnitCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "humanReviewStatus": {
      "enum": [
        "not_reviewed",
        "in_review",
        "approved",
        "rejected"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "PASS"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "not": {
              "contains": {
                "properties": {
                  "result": {
                    "enum": [
                      "WARNING",
                      "FAIL"
                    ]
                  }
                },
                "required": [
                  "result"
                ]
              }
            }
          },
          "findings": {
            "not": {
              "contains": {
                "properties": {
                  "severity": {
                    "enum": [
                      "warning",
                      "blocking"
                    ]
                  }
                },
                "required": [
                  "severity"
                ]
              }
            }
          },
          "metrics": {
            "properties": {
              "missingRecordCount": {
                "const": 0
              },
              "unsupportedFactCount": {
                "const": 0
              },
              "untraceableRecordCount": {
                "const": 0
              },
              "unaccountedSourceUnitCount": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "PASS_WITH_WARNINGS"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "not": {
              "contains": {
                "properties": {
                  "result": {
                    "const": "FAIL"
                  }
                },
                "required": [
                  "result"
                ]
              }
            }
          },
          "findings": {
            "not": {
              "contains": {
                "properties": {
                  "severity": {
                    "const": "blocking"
                  }
                },
                "required": [
                  "severity"
                ]
              }
            }
          },
          "metrics": {
            "properties": {
              "missingRecordCount": {
                "const": 0
              },
              "unsupportedFactCount": {
                "const": 0
              },
              "untraceableRecordCount": {
                "const": 0
              },
              "unaccountedSourceUnitCount": {
                "const": 0
              }
            }
          }
        },
        "anyOf": [
          {
            "properties": {
              "checks": {
                "contains": {
                  "properties": {
                    "result": {
                      "const": "WARNING"
                    }
                  },
                  "required": [
                    "result"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "findings": {
                "contains": {
                  "properties": {
                    "severity": {
                      "const": "warning"
                    }
                  },
                  "required": [
                    "severity"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  ]
}
