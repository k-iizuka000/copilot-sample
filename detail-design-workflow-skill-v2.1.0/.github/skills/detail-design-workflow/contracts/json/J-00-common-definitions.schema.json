{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "J-00-common-definitions.schema.json",
  "title": "J-00 Common Definitions",
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "runInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "generatedAt",
        "skillId",
        "promptVersion",
        "model",
        "humanReviewStatus"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "skillId": {
          "type": "string",
          "pattern": "^(E2J|J2M|EV|D)\\d{2}(-[A-Z0-9]+)?$|^(E2J|J2M|EV)-\\d{2}$"
        },
        "promptVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "humanReviewStatus": {
          "enum": [
            "not_reviewed",
            "in_review",
            "approved",
            "rejected"
          ]
        }
      }
    },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "documentType",
        "sourcePath",
        "workbookName",
        "formatVersion",
        "featureId",
        "featureName",
        "scope"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "documentType": {
          "enum": [
            "screen_design",
            "process_function",
            "batch_design",
            "entity_definition",
            "view_definition",
            "authorization_matrix",
            "common_document",
            "unknown"
          ]
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "workbookName": {
          "type": "string",
          "minLength": 1
        },
        "formatVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "featureId": {
          "type": [
            "string",
            "null"
          ]
        },
        "featureName": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "enum": [
            "feature",
            "shared_master",
            "common",
            "unknown"
          ]
        }
      }
    },
    "sheetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheetName",
        "visibility",
        "role"
      ],
      "properties": {
        "sheetName": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "visible",
            "hidden",
            "very_hidden",
            "unknown"
          ]
        },
        "role": {
          "enum": [
            "metadata",
            "extract",
            "asset",
            "ignore_candidate",
            "reference_only",
            "unknown"
          ]
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceUnitId",
        "workbook",
        "sheet",
        "range",
        "locator",
        "displayedValue",
        "formula",
        "hiddenRow",
        "hiddenColumn",
        "evidenceType"
      ],
      "properties": {
        "sourceUnitId": {
          "type": "string",
          "minLength": 1
        },
        "workbook": {
          "type": "string",
          "minLength": 1
        },
        "sheet": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "type": [
            "string",
            "null"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "displayedValue": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "formula": {
          "type": [
            "string",
            "null"
          ]
        },
        "hiddenRow": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "hiddenColumn": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "evidenceType": {
          "enum": [
            "cell",
            "row",
            "block",
            "section",
            "image",
            "comment",
            "shape",
            "formula",
            "derived"
          ]
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issueId",
        "issueType",
        "severity",
        "summary",
        "question",
        "sourceRefs",
        "affectedRecordIds",
        "status",
        "suggestedAction"
      ],
      "properties": {
        "issueId": {
          "type": "string",
          "minLength": 1
        },
        "issueType": {
          "enum": [
            "missing_required_value",
            "ambiguous_text",
            "cross_document_conflict",
            "unknown_sheet",
            "unsupported_visual",
            "untraceable_source",
            "scope_unknown",
            "layer_unknown",
            "format_version_unknown",
            "input_truncated",
            "possible_duplicate",
            "canonical_source_conflict",
            "profile_mismatch",
            "formula_error",
            "hidden_content",
            "read_failure",
            "other"
          ]
        },
        "severity": {
          "enum": [
            "blocking",
            "warning",
            "info"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "affectedRecordIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "accepted"
          ]
        },
        "suggestedAction": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "coverageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceUnitId",
        "disposition",
        "recordIds",
        "reason"
      ],
      "properties": {
        "sourceUnitId": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "extracted",
            "metadata",
            "asset",
            "ignored",
            "reference_only",
            "issue"
          ]
        },
        "recordIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "assetType",
        "status",
        "sourceRefs",
        "targetPath",
        "caption"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "assetType": {
          "enum": [
            "screen_layout",
            "image",
            "drawing",
            "chart",
            "comment",
            "vml",
            "template",
            "sample",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "referenced",
            "exported",
            "missing",
            "unreadable",
            "not_required"
          ]
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "targetPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceUnitCount",
        "accountedSourceUnitCount",
        "unaccountedSourceUnitCount",
        "recordCount",
        "issueCount",
        "assetCount"
      ],
      "properties": {
        "sourceUnitCount": {
          "type": "integer",
          "minimum": 0
        },
        "accountedSourceUnitCount": {
          "type": "integer",
          "minimum": 0
        },
        "unaccountedSourceUnitCount": {
          "type": "integer",
          "minimum": 0
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0
        },
        "issueCount": {
          "type": "integer",
          "minimum": 0
        },
        "assetCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "recordBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordId",
        "recordType",
        "scope",
        "layers",
        "executionModes",
        "evidenceState",
        "sourceRefs",
        "notes"
      ],
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1
        },
        "recordType": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "individual",
            "common",
            "shared_master",
            "unknown"
          ]
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "frontend",
              "backend",
              "db",
              "integration",
              "test",
              "authorization"
            ]
          }
        },
        "executionModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "online",
              "batch",
              "shared",
              "unknown"
            ]
          }
        },
        "evidenceState": {
          "enum": [
            "explicit",
            "derived",
            "ambiguous"
          ]
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
