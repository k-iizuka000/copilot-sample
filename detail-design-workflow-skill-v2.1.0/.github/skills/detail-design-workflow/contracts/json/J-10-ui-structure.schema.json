{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "J-10-ui-structure.schema.json",
  "title": "J-10 UI Structure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "schemaVersion",
    "run",
    "document",
    "status",
    "coverage",
    "issues",
    "assets",
    "summary",
    "records"
  ],
  "properties": {
    "contractId": {
      "const": "J-10"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "run": {
      "$ref": "J-00-common-definitions.schema.json#/$defs/runInfo"
    },
    "document": {
      "$ref": "J-00-common-definitions.schema.json#/$defs/documentRef"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "J-00-common-definitions.schema.json#/$defs/coverageItem"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "J-00-common-definitions.schema.json#/$defs/issue"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "J-00-common-definitions.schema.json#/$defs/assetRef"
      }
    },
    "summary": {
      "$ref": "J-00-common-definitions.schema.json#/$defs/summary"
    },
    "records": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recordId",
              "recordType",
              "scope",
              "layers",
              "executionModes",
              "evidenceState",
              "sourceRefs",
              "facts",
              "notes"
            ],
            "properties": {
              "recordId": {
                "type": "string",
                "minLength": 1
              },
              "recordType": {
                "const": "screen_item"
              },
              "scope": {
                "enum": [
                  "individual",
                  "common",
                  "shared_master",
                  "unknown"
                ]
              },
              "layers": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "frontend",
                    "backend",
                    "test"
                  ]
                }
              },
              "executionModes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "online",
                    "batch",
                    "shared",
                    "unknown"
                  ]
                }
              },
              "evidenceState": {
                "enum": [
                  "explicit",
                  "derived",
                  "ambiguous"
                ]
              },
              "sourceRefs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "J-00-common-definitions.schema.json#/$defs/sourceRef"
                }
              },
              "facts": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "itemNumber",
                  "name",
                  "attribute",
                  "i18n",
                  "minimum",
                  "maximum",
                  "format",
                  "align",
                  "note",
                  "initialDisplay",
                  "listDisplay"
                ],
                "properties": {
                  "itemNumber": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "attribute": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "i18n": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "minimum": {
                    "type": [
                      "integer",
                      "number",
                      "string",
                      "null"
                    ]
                  },
                  "maximum": {
                    "type": [
                      "integer",
                      "number",
                      "string",
                      "null"
                    ]
                  },
                  "format": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "align": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "note": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "initialDisplay": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "listDisplay": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recordId",
              "recordType",
              "scope",
              "layers",
              "executionModes",
              "evidenceState",
              "sourceRefs",
              "facts",
