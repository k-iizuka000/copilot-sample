                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "frontend",
                    "test"
                  ]
                }
              },
              "executionModes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "online",
                    "batch",
                    "shared",
                    "unknown"
                  ]
                }
              },
              "evidenceState": {
                "enum": [
                  "explicit",
                  "derived",
                  "ambiguous"
                ]
              },
              "sourceRefs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "J-00-common-definitions.schema.json#/$defs/sourceRef"
                }
              },
              "facts": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "displayMode",
                  "description",
                  "layoutAssetId"
                ],
                "properties": {
                  "displayMode": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "layoutAssetId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recordId",
              "recordType",
              "scope",
              "layers",
              "executionModes",
              "evidenceState",
              "sourceRefs",
              "facts",
