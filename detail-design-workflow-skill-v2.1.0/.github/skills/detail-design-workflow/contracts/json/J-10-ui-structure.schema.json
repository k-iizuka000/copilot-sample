                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "frontend",
                    "backend",
                    "integration",
                    "test"
                  ]
                }
              },
              "executionModes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "online",
                    "batch",
                    "shared",
                    "unknown"
                  ]
                }
              },
              "evidenceState": {
                "enum": [
                  "explicit",
                  "derived",
                  "ambiguous"
                ]
              },
              "sourceRefs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "J-00-common-definitions.schema.json#/$defs/sourceRef"
                }
              },
              "facts": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "displayMode",
                  "urlFormat",
                  "parameterName",
                  "usage"
                ],
                "properties": {
                  "displayMode": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "urlFormat": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "parameterName": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "usage": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recordId",
              "recordType",
              "scope",
              "layers",
              "executionModes",
              "evidenceState",
              "sourceRefs",
              "facts",
              "notes"
            ],
            "properties": {
              "recordId": {
                "type": "string",
                "minLength": 1
              },
              "recordType": {
                "const": "layout_reference"
              },
              "scope": {
                "enum": [
                  "individual",
                  "common",
                  "shared_master",
                  "unknown"
                ]
              },
              "layers": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "frontend",
                    "test"
                  ]
                }
              },
              "executionModes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "online",
                    "batch",
                    "shared",
                    "unknown"
                  ]
                }
              },
              "evidenceState": {
                "enum": [
                  "explicit",
                  "derived",
                  "ambiguous"
                ]
              },
              "sourceRefs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "J-00-common-definitions.schema.json#/$defs/sourceRef"
                }
              },
              "facts": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "assetId",
                  "displayMode",
                  "description"
                ],
                "properties": {
                  "assetId": {
                    "type": "string"
                  },
                  "displayMode": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
