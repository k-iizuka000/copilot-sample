{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "J-99-issue-coverage.schema.json",
  "title": "J-99 Issues and Coverage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "schemaVersion",
    "issues",
    "coverage",
    "summary"
  ],
  "properties": {
    "contractId": {
      "const": "J-99"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "J-00-common-definitions.schema.json#/$defs/issue"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "J-00-common-definitions.schema.json#/$defs/coverageItem"
      }
    },
    "summary": {
      "$ref": "J-00-common-definitions.schema.json#/$defs/summary"
    }
  }
}
